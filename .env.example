# Environment & Secrets
ENVIRONMENT=development
SERVICE_KEY=lyfpartner-secret-service-key-2026
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./lyfpartner.db
STORE_AUDIO=false

# Voice Limits (kobo)
PER_TRANSFER_LIMIT_KOBO=5000000 # 50,000 NGN
DAILY_TRANSFER_LIMIT_KOBO=10000000 # 100,000 NGN
REQUIRE_SAVED_BENEFICIARY_FOR_VOICE=true

# Providers: "mock", or live when keys provided
ASR_PROVIDER=mock
TTS_PROVIDER=mock
LLM_PROVIDER=mock
VOICE_VERIFY_PROVIDER=mock
BANK_PROVIDER=mock
KYC_PROVIDER=mock
SMS_PROVIDER=mock

# External Vendor Keys (optional for mock mode)
HF_TOKEN=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SPITCH_API_KEY=
AT_API_KEY=
AT_USERNAME=sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Service Endpoints
GATEWAY_URL=http://localhost:8000
ASR_URL=http://localhost:8001
AGENT_URL=http://localhost:8002
TTS_URL=http://localhost:8003
AUTH_URL=http://localhost:8004
BANK_URL=http://localhost:8005
KYC_URL=http://localhost:8006
SUPPORT_URL=http://localhost:8007
ADMIN_URL=http://localhost:8008
NOTIFY_URL=http://localhost:8009
